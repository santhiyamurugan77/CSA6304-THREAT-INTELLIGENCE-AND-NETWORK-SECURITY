
events = [
    {"source": "Firewall", "ip": "203.0.113.5"},
    {"source": "VPN", "ip": "203.0.113.5"},
    {"source": "Windows", "ip": "203.0.113.5"}
]

counts = {}

# Normalize and correlate
for event in events:
    event["source"] = event["source"].lower()
    ip = event["ip"]
    counts[ip] = counts.get(ip, 0) + 1

print("Normalized events:", events)

for ip, count in counts.items():
    if count >= 3:
        print("ALERT: Multiple events from", ip)
