
description = input("Describe network threat: ").lower()

if "fake email" in description or "phishing" in description:
    print("Threat: Phishing")
elif "flood" in description or "denial of service" in description:
    print("Threat: DoS/DDoS")
elif "ransomware" in description or "malware" in description:
    print("Threat: Malware")
elif "intercept" in description or "man-in-the-middle" in description:
    print("Threat: Man-in-the-Middle")
else:
    print("Threat category unclear")
